GEMINI_API_KEY=
# Optional Langfuse tracing. Use the URL for your project's region or deployment.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
CHAT_MODEL=gemini-3.5-flash-lite
THINKING_LEVEL=minimal
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
CHROMA_DIR=./.local/chroma
# Collection names; ingest creates the knowledge collections if they do not exist.
CHROMA_PRODUCT_COLLECTION=brochures
CHROMA_SERVICE_COLLECTION=service_reports
CHROMA_MEMORY_COLLECTION=conversations
DATA_DIR=./data
RETRIEVAL_K=12
HISTORY_TURNS=6
API_TIMEOUT_SECONDS=45
MAX_API_RETRIES=2
